{
  "name": "ntis-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev-with-extraction.js",
    "dev:next": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:production": "next build --turbo",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@esri/wayback-core": "^1.1.0",
    "@heroicons/react": "^2.2.0",
    "@microsoft/signalr": "^10.0.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "^5.100.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "2.26.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "motion": "^12.40.0",
    "next": "16.1.2",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "4.10.38",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.0",
    "react-easy-crop": "^6.0.2",
    "react-icons": "^5.6.0",
    "react-image-crop": "^11.1.2",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^6.24.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-plugin-i18next": "^6.1.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}

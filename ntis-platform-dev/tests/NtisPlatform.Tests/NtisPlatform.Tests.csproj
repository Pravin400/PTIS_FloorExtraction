<Project Sdk="Microsoft.NET.Sdk">

	<!-- All common properties are inherited from Directory.Build.props -->

	<PropertyGroup>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
	  <!-- Pre-existing exclusion: this file references PropertyMastOldEntity/PropertyRepository
	       members (OldConstArea, PropertyId, GetOldDetailsAsync, UpdateOldDetailsAsync) that no
	       longer exist, from before this PR. The PropertyRepository constructor call sites were
	       fixed to the current (context, IFinanceYearProvider) signature regardless, but fully
	       resurrecting this file needs its own separate pass. -->
	  <Compile Remove="Application\PropertyOldDetailsTests.cs" />
	</ItemGroup>

	<ItemGroup>
